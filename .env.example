# Wildraft Environment Variables
# Copy this file to .env and fill in your values

# ============================================================================
# DATABASE CONFIGURATION
# ============================================================================

# For local Docker Compose (these are defaults, can be overridden)
POSTGRES_PASSWORD=wildraft_secret

# For production/Railway deployment:
# Get DATABASE_URL from your Railway PostgreSQL plugin dashboard
# Format: postgresql://user:password@host:port/database?schema=public
# DATABASE_URL=postgresql://user:password@host:port/database?schema=public

# ============================================================================
# API SERVER CONFIGURATION
# ============================================================================
PORT=3000
HOST=0.0.0.0
NODE_ENV=development

# ============================================================================
# AWS S3 STORAGE (optional - required for file uploads)
# ============================================================================
AWS_REGION=us-east-1
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_S3_BUCKET=wildraft
AWS_ENDPOINT=https://s3.amazonaws.com

# ============================================================================
# OPENAI CONFIGURATION (optional - for AI features)
# ============================================================================
# OPENAI_API_KEY=sk-...
